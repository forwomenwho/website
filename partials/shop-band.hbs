<section class="shop-band" id="shop" aria-labelledby="shop-title">
    <div class="shop-band__stage">
        <h2 class="shop-band__wordmark" id="shop-title"><a href="{{@site.url}}/shop/">The Shop</a></h2>
        {{#if @custom.shop_figure_image}}
            <img class="shop-band__figure" src="{{img_url @custom.shop_figure_image size="m"}}" srcset="{{img_url @custom.shop_figure_image size="s"}} 400w, {{img_url @custom.shop_figure_image size="m"}} 800w, {{img_url @custom.shop_figure_image size="l"}} 1200w" sizes="(min-width: 700px) 260px, 160px" alt="" width="900" height="1500" loading="lazy" decoding="async">
        {{/if}}
    </div>
</section>
<nav class="shop-strip" aria-label="Shop categories">
    {{> "shop-category" name="Planners" anchor="planners" cta="Shop planners" photo=@custom.shop_planners_image}}
    {{> "shop-category" name="Journals" anchor="journals" cta="Shop journals" photo=@custom.shop_journals_image}}
    {{> "shop-category" name="The Magazine" anchor="magazine" cta="Shop the magazine" photo=@custom.shop_magazine_image}}
    {{> "shop-category" name="Wallpapers" anchor="wallpapers" cta="Shop wallpapers" photo=@custom.shop_wallpapers_image}}
</nav>
