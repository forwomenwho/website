<footer class="site-footer">
    <div class="site-footer__wordmark-wrap">
        <a class="site-footer__wordmark" href="{{@site.url}}">For Women Who</a>
    </div>
    <div class="site-footer__links">
        <nav class="site-footer__nav" aria-label="Footer">{{navigation}}</nav>
        <ul class="site-footer__social">
            {{#if @custom.instagram_url}}<li><a href="{{@custom.instagram_url}}" rel="noopener">Instagram</a></li>{{/if}}
            {{#if @custom.pinterest_url}}<li><a href="{{@custom.pinterest_url}}" rel="noopener">Pinterest</a></li>{{/if}}
            {{#if @custom.contact_email}}<li><a href="mailto:{{@custom.contact_email}}">Contact</a></li>{{/if}}
        </ul>
    </div>
    <div class="site-footer__legal">
        <span>© {{@site.title}}</span>
        {{navigation type="secondary"}}
    </div>
</footer>
