{{!-- Responsive image. Params: src, alt, sizes, class, width, height, eager (first screen only). --}}
<img class="{{class}}" src="{{img_url src size="l"}}" srcset="{{img_url src size="s"}} 400w, {{img_url src size="m"}} 800w, {{img_url src size="l"}} 1200w, {{img_url src size="xl"}} 1600w, {{img_url src size="xxl"}} 2400w" sizes="{{#if sizes}}{{sizes}}{{else}}100vw{{/if}}" alt="{{alt}}" width="{{#if width}}{{width}}{{else}}1600{{/if}}" height="{{#if height}}{{height}}{{else}}2000{{/if}}"{{#if eager}} fetchpriority="high" decoding="async"{{else}} loading="lazy" decoding="async"{{/if}}>
