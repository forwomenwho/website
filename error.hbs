<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{statusCode}} — {{@site.title}}</title>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
</head>
<body class="error-template">
<main id="main" class="site-main">
    <section class="wordmark-header band band--ivory not-found">
        <div class="wordmark-header__fit">
            <h1 class="wordmark-header__title">{{statusCode}}</h1>
        </div>
        <p class="standfirst wordmark-header__standfirst">{{message}}</p>
        <div class="not-found__actions">
            <a class="button" href="{{@site.url}}">Go to the homepage</a>
        </div>
    </section>
</main>
</body>
</html>
