{{!< default}}
{{!-- 404 (not mocked up). Built from the Issues header: giant wordmark on ivory. --}}
<section class="wordmark-header band band--ivory not-found">
    <div class="wordmark-header__fit">
        <h1 class="wordmark-header__title"><span class="visually-hidden">Page not found: </span>404</h1>
    </div>
    <p class="standfirst wordmark-header__standfirst">We couldn’t find that page.</p>
    <div class="not-found__actions">
        <a class="button" href="{{@site.url}}">Go to the homepage</a>
        <button class="button button--outline" type="button" data-ghost-search>Search the magazine</button>
    </div>
</section>
