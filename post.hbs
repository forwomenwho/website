{{!< default}}
{{!-- Article (mockups Article / ArticleMobile). --}}
{{#post}}
<article class="article {{post_class}}">

    <header class="article-hero{{#if feature_image}} has-image{{/if}}">
        {{#if feature_image}}
            {{> "image" src=feature_image alt=feature_image_alt class="article-hero__image" sizes="100vw" width="2400" height="1600" eager=true}}
        {{/if}}
        <div class="article-hero__text">
            <p class="label article-hero__kicker">{{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}{{#foreach tags}}{{#match slug "~^" "issue-"}} · <a href="{{url}}">{{name}}</a>{{/match}}{{/foreach}} · {{reading_time}}</p>
            <h1 class="article-hero__title">{{> "accent-text" text=title}}</h1>
            {{#if custom_excerpt}}<p class="standfirst article-hero__standfirst">{{custom_excerpt}}</p>{{/if}}
        </div>
    </header>
    {{#if feature_image_caption}}<p class="article-hero__caption">{{feature_image_caption}}</p>{{/if}}

    <div class="article-body content">
        {{content}}
    </div>

    <footer class="article-end">
        <span>{{#foreach tags}}{{#match slug "~^" "issue-"}}This piece first appeared in <a href="{{url}}">{{name}}</a>{{/match}}{{/foreach}}</span>
        <span>{{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}</span>
    </footer>

</article>

{{!-- The one subscribe prompt: at the end of the article, never partway through. --}}
{{> "subscribe" style="split" heading="A weekly magazine for women who have things to do."}}

{{/post}}

{{#if post.primary_tag}}
{{#get "posts" filter="primary_tag:{{post.primary_tag.slug}}+id:-{{post.id}}" include="tags" limit="3" as |more|}}
<section class="more band" aria-labelledby="more-title">
    {{#foreach more limit="1"}}{{#primary_tag}}
    <header class="section-header">
        <h2 class="section-header__title" id="more-title">More from {{name}}</h2>
        <a class="small-link" href="{{url}}">All of {{name}}</a>
    </header>
    {{/primary_tag}}{{/foreach}}
    <div class="grid grid--3">
        {{#foreach more}}{{> "cards/post" style="simple"}}{{/foreach}}
    </div>
</section>
{{/get}}
{{/if}}
